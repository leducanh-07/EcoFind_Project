# =============================================================================
# EcoFind Docker Deployment Environment Variables (.env.docker)
# Task TE9C75A (DevOps / Docker Compose)
# =============================================================================

APP_NAME=EcoFind API
APP_ENV=production
APP_PORT=8000
DEBUG=False

# Cấu hình CSDL PostgreSQL chạy trong Docker container 'db'
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecofind_db

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ecofind_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ecofind_db

# Bảo mật JWT
JWT_SECRET_KEY=ecofind_super_secret_jwt_production_key_2026_xyz123
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Lưu trữ hình ảnh tải lên
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_BYTES=5242880
MAX_IMAGE_COUNT=5

# Nguồn CORS cho phép
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173,http://127.0.0.1
