# App Configuration
APP_NAME=EcoFind
APP_ENV=development
APP_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecofind_db

# Security & JWT
JWT_SECRET_KEY=supersecretjwtkey_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Nominatim Geocoding
NOMINATIM_USER_AGENT=EcoFindApp/1.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
